<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/public/img/favicon.png" />

    <title><%= title || 'UsinaSoft' %></title>
    <!-- Bootstrap CSS -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <!-- FontAwesome -->
    <link
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
      rel="stylesheet"
    />
    <!-- UsinaSoft Custom CSS -->
    <link rel="stylesheet" href="/css/usinasoft-bootstrap.css" />
  </head>
  <body class="login-page">
    <%- include('partials/header', { user: user, showNav: true, currentPage:
    'menu' }) %>

    <main class="main-content">
      <div class="container py-5">
        <!-- Page Header -->
        <div class="text-center mb-5">
          <h1 class="display-4 fw-bold text-usinasoft-primary mb-3">
            Menu Principal
          </h1>
          <p class="lead text-muted">
            Selecione uma das opções abaixo para gerenciar sua produção
          </p>
        </div>

        <!-- Menu Cards -->
        <div class="row g-4">
          <div class="col-lg-3 col-md-6">
            <div class="card menu-card h-100 text-center">
              <div class="card-body d-flex flex-column">
                <div class="menu-icon mb-3"><i class="fas fa-users"></i></div>
                <h5 class="menu-title">Clientes</h5>
                <p class="menu-description">
                  Cadastre e gerencie seus clientes
                </p>
                <div class="mt-auto">
                  <a href="/clientes" class="btn btn-primary btn-lg w-100"
                    >Acessar</a
                  >
                </div>
              </div>
            </div>
          </div>

          <div class="col-lg-3 col-md-6">
            <div class="card menu-card h-100 text-center">
              <div class="card-body d-flex flex-column">
                <div class="menu-icon mb-3"><i class="fas fa-hammer"></i></div>
                <h5 class="menu-title">Cadastrar Peças</h5>
                <p class="menu-description">
                  Registre novas peças e ordens de produção
                </p>
                <div class="mt-auto">
                  <a href="/cadastro" class="btn btn-primary btn-lg w-100"
                    >Acessar</a
                  >
                </div>
              </div>
            </div>
          </div>

          <div class="col-lg-3 col-md-6">
            <div class="card menu-card h-100 text-center">
              <div class="card-body d-flex flex-column">
                <div class="menu-icon mb-3"><i class="fas fa-cogs"></i></div>
                <h5 class="menu-title">Controle de Produção</h5>
                <p class="menu-description">
                  Gerencie a fila de produção e status das peças
                </p>
                <div class="mt-auto">
                  <a href="/producao" class="btn btn-primary btn-lg w-100"
                    >Acessar</a
                  >
                </div>
              </div>
            </div>
          </div>

          <div class="col-lg-3 col-md-6">
            <div class="card menu-card h-100 text-center">
              <div class="card-body d-flex flex-column">
                <div class="menu-icon mb-3">
                  <i class="fas fa-chart-bar"></i>
                </div>
                <h5 class="menu-title">Indicadores</h5>
                <p class="menu-description">
                  Visualize métricas e relatórios de produção
                </p>
                <div class="mt-auto">
                  <a href="/indicadores" class="btn btn-primary btn-lg w-100"
                    >Acessar</a
                  >
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>

    <%- include('partials/footer') %>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/main.js"></script>
  </body>
</html>
