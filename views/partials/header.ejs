<header
  class="navbar navbar-expand-lg navbar-dark bg-usinasoft-primary shadow-sm"
>
  <div class="container-fluid">
    <!-- Brand -->
    <a href="/menu" class="navbar-brand">
      <img
        src="/img/fabrica.png"
        alt="UsinaSoft"
        style="width: 8vw; height: 8vh; object-fit: cover"
      />
    </a>

    <!-- Mobile Toggle -->
    <button
      class="navbar-toggler d-lg-none"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarNav"
    >
      <span class="navbar-toggler-icon"></span>
    </button>

    <!-- Navigation Menu -->
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav ms-auto w-100 d-flex justify-content-end gap-1">
        <li class="nav-item">
          <a
            href="/menu"
            class="nav-link d-flex align-items-center gap-2 <%= currentPage === 'menu' ? 'active' : '' %>"
          >
            <i class="fas fa-home"></i>
            <span class="d-lg-none">Menu Principal</span>
          </a>
        </li>
        <li class="nav-item">
          <a
            href="/cadastro"
            class="nav-link d-flex align-items-center gap-2 <%= currentPage === 'cadastro' ? 'active' : '' %>"
          >
            <i class="fas fa-edit"></i>
            <span class="d-lg-none">Cadastrar Peças</span>
          </a>
        </li>
        <li class="nav-item">
          <a
            href="/producao"
            class="nav-link d-flex align-items-center gap-2 <%= currentPage === 'producao' ? 'active' : '' %>"
          >
            <i class="fas fa-cogs"></i>
            <span class="d-lg-none">Controle de Produção</span>
          </a>
        </li>
        <li class="nav-item">
          <a
            href="/indicadores"
            class="nav-link d-flex align-items-center gap-2 <%= currentPage === 'indicadores' ? 'active' : '' %>"
          >
            <i class="fas fa-chart-bar"></i>
            <span class="d-lg-none">Indicadores</span>
          </a>
        </li>
        <% if (typeof user !== 'undefined' && user) { %>
        <li class="nav-item ms-auto d-flex align-items-center">
          <span class="text-white me-3 d-none d-lg-inline"
            >Olá, <%= user.full_name %></span
          >
          <a href="/logout" class="btn btn-outline-light btn-sm">Sair</a>
        </li>
        <% } %>
      </ul>
    </div>
  </div>
</header>

<link rel="stylesheet" href="/css/producao.css" />
<link rel="stylesheet" href="/css/indicadores.css" />
<title><%= title %></title>

<script>
  // Log do usuário logado
  const usuarioLogado = <%- JSON.stringify(user || null) %>;
  console.log('Usuário Logado:', usuarioLogado);
</script>
